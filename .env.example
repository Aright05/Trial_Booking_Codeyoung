# Root Environment Configuration (Template)
# Copy to server/.env and client/.env

# Server & Database Settings
PORT=5001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:172005@127.0.0.1:5000/postgres
CLIENT_URL=http://localhost:5173
ADMIN_API_KEY=codeyoung-admin-secret-dev


# Email Service Configuration (Nodemailer)
# In development, leave EMAIL_USER and EMAIL_PASS blank to automatically generate an Ethereal sandbox test account.
# Or provide your custom SMTP credentials:
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Codeyoung Trial Classes <no-reply@codeyoung.com>

# Meeting & Demo Classroom Base URL
DEMO_CLASS_BASE_URL=https://meet.codeyoung.com/room

# Frontend Client Environment
VITE_API_BASE_URL=http://localhost:5001/api
